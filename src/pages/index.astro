---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { site, listedWork, featuredWork } from '../lib/content.js';
---
<Base>
  <section class="intro" data-enter set:html={site.introHtml} />

  <section class="section" data-enter>
    <div class="section-head">
      <h2 class="section-title">Selected work</h2>
      <a class="more" href="/work">
        <span>All {listedWork.length}</span>
        <svg class="arrow" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6h7M6.5 3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="grid" data-grid>
      {featuredWork.map((w) => <Tile project={w} />)}
    </div>
  </section>
</Base>
