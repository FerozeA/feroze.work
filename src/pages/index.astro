---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { allWork, featuredWork, allLibrary } from '../lib/content.js';
import { Content as Intro } from '../content/home.md';
const libraryList = [...allLibrary.filter((p) => p.draft), ...allLibrary.filter((p) => !p.draft)];
---
<Base>
  <section class="home-intro">
    <Intro />
  </section>

  <section class="section">
    <a class="label label-link" href="/work" style="color: var(--ink)" aria-label={`See all ${allWork.length}+ projects`}>
      <span class="pill-text">Work <small>{allWork.length}+</small></span>
    </a>
    <div class="grid">
      {featuredWork.map((w) => <Tile project={w} />)}
    </div>
  </section>

  <section class="section">
    <h2 class="label">Library</h2>
    <ul class="list">
      {libraryList.map((p) => (
        <li>
          {p.draft ? (
            <div class="row draft">
              <span>{p.title}</span><span class="meta">Draft</span><span class="meta">{p.short}</span>
            </div>
          ) : (
            <a href={`/library/${p.slug}`}>
              <span>{p.title}</span><span class="meta">{p.tag}</span><span class="meta">{p.short}</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>
</Base>
