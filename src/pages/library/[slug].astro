---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { allLibrary } from '../../lib/content.js';

export function getStaticPaths() {
  return allLibrary
    .filter((p) => !p.draft)
    .map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = post;
---
<Base title={post.title}>
  <Crumbs items={[{ label: 'Home', href: '/' }, { label: post.title }]} />
  <h1 class="title">{post.title}</h1>
  {post.date && <p class="date">{post.date}</p>}
  <div class="prose"><Content /></div>
  {post.footer && (
    <aside class="postnote">
      If you’re wondering why an engineer is writing about {post.footer}, it's for three reasons:
      <ol>
        <li>I’m trying to understand the broader scope.</li>
        <li>I’m building my communication skills.</li>
        <li>I’m entering the feedback loop.</li>
      </ol>
      If you’re still confused, read my <a href="/library/whyblog">full post on why I’m writing a blog</a>.
    </aside>
  )}
</Base>
