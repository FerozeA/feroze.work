---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Tile from '../../components/Tile.astro';
import { categories, workByCategory } from '../../lib/content.js';
---
<Base title="Work">
  <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Work' }]} />
  {categories.map((c) => (
    <section class="section">
      <h2 class="label">{c.label}</h2>
      <div class="grid">
        {workByCategory(c.id).map((w) => <Tile project={w} />)}
      </div>
    </section>
  ))}
</Base>
