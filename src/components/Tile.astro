---
import Media from './Media.astro';
const { project } = Astro.props;
---
<a class:list={['tile', { 'has-media': !!project.cover }]} href={`/work/${project.slug}`}>
  {project.cover && <Media item={project.cover} sizes="(max-width: 640px) 50vw, 210px" />}
  <span class="tile-name"><span>{project.title}</span></span>
</a>
